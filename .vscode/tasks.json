{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",

            "type": "shell",

            "command": "zig",
            "args": [
                "build",

                "-Dtarget=x86_64-windows-gnu",
                "-Doptimize=Debug",

                "-freference-trace=6"
            ],

            "group": {
                "kind": "build",
                "isDefault": true
            }
        },

        {
            "label": "Test",

            "type": "shell",

            "command": "zig",
            "args": [
                "build",
                "test",

                "-Dtarget=x86_64-windows-gnu",
                "-Doptimize=Debug",

                "-freference-trace=6"
            ],

            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
